{
  "manifest_version": 3,
  "name": "Conversation Spiderweb",
  "version": "1.0",
  "description": "Maps who spoke, for how long, and who interrupted whom during a call.",
  "action": {
    "default_title": "Open Spiderweb",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
